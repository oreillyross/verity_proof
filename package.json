{
  "name": "project-log",
  "private": true,
  "version": "0.1.0",
  "main": "src/main/main.js",
 "scripts": {
    "build": "tsc && vite build",
    "electron:build": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.yourco.yourapp",
    "directories": {
      "output": "dist"
    },
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "vite": "latest"
  }
}
